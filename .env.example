SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_TU_CLAVE

# Correos de aviso. Opción recomendada: el correo de Bluehost (SMTP).
# Copia el servidor y el puerto desde Bluehost → Email → Connect Devices.
SMTP_HOST=hidroterra.cl
SMTP_PORT=465
SMTP_USER=ventas@hidroterra.cl
SMTP_PASS=contraseña_del_correo
CONTACT_TO_EMAIL=ventas@hidroterra.cl
CONTACT_FROM_EMAIL=Hidroterra Web <ventas@hidroterra.cl>

# Alternativa: Resend (se usa solo si no hay SMTP configurado).
# RESEND_API_KEY=re_TU_CLAVE
